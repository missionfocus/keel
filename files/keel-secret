#!/usr/bin/env bash
#
# keel-secret -- resolve an `op://vault/item/field` reference to its value via
# the exe.dev 1Password Connect integration.
#
#   keel-secret op://keel/borg-fleet/passphrase
#
# The Connect token is injected at the network edge by exe.dev, so this VM can
# USE the integration but can never read the credential. Nothing is written to
# disk: the value goes to stdout and the caller decides its lifetime.
#
# Requires the VM to carry a tag the `onepassword` integration is attached to
# (today: dev or prod). Without it the hostname does not resolve and this fails
# loudly, which is the intended signal.

set -euo pipefail

OP_BASE="${KEEL_OP_BASE:-https://onepassword.int.exe.xyz}"
CACHE_DIR="${KEEL_OP_CACHE:-/run/keel/opcache}"

die() { printf 'keel-secret: %s\n' "$*" >&2; exit 1; }

ref="${1:-}"
[ -n "$ref" ] || die "usage: keel-secret op://<vault>/<item>/<field>"
case "$ref" in
    op://*) ;;
    *) die "not an op:// reference: $ref" ;;
esac

rest="${ref#op://}"
vault="${rest%%/*}"; rest="${rest#*/}"
item="${rest%%/*}"; field="${rest#*/}"
[ -n "$vault" ] && [ -n "$item" ] && [ -n "$field" ] \
    || die "malformed reference (want op://vault/item/field): $ref"
case "$field" in */*) die "field may not contain '/': $field" ;; esac

op_get() { curl --fail --silent --show-error --max-time 20 \
               --retry 3 --retry-delay 2 --retry-all-errors "$@"; }

# Vault and item UUIDs are stable, so cache them for the life of the boot --
# it turns a three-request lookup into one for every call after the first.
# /run is tmpfs, so the cache dies with the machine.
cache_get() {
    [ -r "$CACHE_DIR/$1" ] && cat "$CACHE_DIR/$1"
}
cache_put() {
    mkdir -p "$CACHE_DIR" && chmod 0700 "$CACHE_DIR" 2>/dev/null || return 0
    printf '%s' "$2" > "$CACHE_DIR/$1" 2>/dev/null || true
}

vault_id="$(cache_get "vault.$vault" || true)"
if [ -z "${vault_id:-}" ]; then
    vault_id="$(op_get --get --data-urlencode "filter=name eq \"$vault\"" \
        "$OP_BASE/v1/vaults" | jq -r '.[0].id // empty')"
    [ -n "$vault_id" ] || die "vault not found: $vault"
    cache_put "vault.$vault" "$vault_id"
fi

item_id="$(cache_get "item.$vault.$item" || true)"
if [ -z "${item_id:-}" ]; then
    item_id="$(op_get --get --data-urlencode "filter=title eq \"$item\"" \
        "$OP_BASE/v1/vaults/$vault_id/items" | jq -r '.[0].id // empty')"
    [ -n "$item_id" ] || die "item not found in vault '$vault': $item"
    cache_put "item.$vault.$item" "$item_id"
fi

# Match on label first, then on the standard `purpose` (USERNAME/PASSWORD/NOTES)
# so `.../password` resolves on a plain Login item whose field is unlabelled.
value="$(op_get "$OP_BASE/v1/vaults/$vault_id/items/$item_id" | jq -r --arg f "$field" '
    ( [ .fields[]? | select(.label == $f)                    | .value ][0] )
    // ( [ .fields[]? | select((.purpose // "") | ascii_downcase == ($f | ascii_downcase)) | .value ][0] )
    // empty')"
[ -n "$value" ] || die "field not found on item '$item': $field"

# No trailing newline: callers pipe this straight into files (atuin) and
# commands (borg BORG_PASSCOMMAND) that are sensitive to one.
printf '%s' "$value"
